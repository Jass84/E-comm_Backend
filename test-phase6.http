### PHASE 6 - COUPON SYSTEM TESTS
### Test coupon creation, validation, and application at checkout

### Variables
@baseUrl = http://localhost:5000/api
@adminToken = YOUR_ADMIN_TOKEN_HERE
@userToken = YOUR_USER_TOKEN_HERE

###############################################################
### SETUP - Login to get tokens
###############################################################

### 1. Admin Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ecommerce.com",
  "password": "admin123"
}

###

### 2. User Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "buyer123"
}

###

###############################################################
### ADMIN - CREATE COUPONS
###############################################################

### 3. Create Percentage Coupon (10% off)
POST {{baseUrl}}/coupons
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "SAVE10",
  "description": "Get 10% off on your order",
  "discountType": "percentage",
  "discountValue": 10,
  "minimumOrderAmount": 500,
  "maximumDiscount": 200,
  "expiryDate": "2026-12-31",
  "usageLimit": 100,
  "usageLimitPerUser": 1
}

###

