###############################################################
### USER - VALIDATE COUPONS
###############################################################

### 17. Validate SAVE10 Coupon (₹1000 order)
# Expected: 10% off = ₹100 discount
POST {{baseUrl}}/coupons/validate
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "code": "SAVE10",
  "orderAmount": 1000
}

###

### 18. Validate FLAT100 Coupon (₹600 order)
# Expected: Flat ₹100 discount
POST {{baseUrl}}/coupons/validate
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "code": "FLAT100",
  "orderAmount": 600
}

###

### 19. Validate with Insufficient Amount
# Expected: Error - Minimum order not met
POST {{baseUrl}}/coupons/validate
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "code": "SAVE10",
  "orderAmount": 300
}

###

### 20. Validate Invalid Coupon
# Expected: Error - Invalid coupon code
POST {{baseUrl}}/coupons/validate
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "code": "INVALID123",
  "orderAmount": 1000
}

