# Commission on ₹900: Admin ₹90, Seller ₹810
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [
    {
      "product": "REPLACE_WITH_PRODUCT_ID",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "fullName": "Test User",
    "phone": "9876543210",
    "addressLine1": "123 Test Street",
    "city": "Mumbai",
    "state": "Maharashtra",
    "pincode": "400001"
  },
  "paymentMethod": "COD",
  "itemsPrice": 900,
  "shippingPrice": 50,
  "taxPrice": 50,
  "totalPrice": 1000,
  "couponCode": "SAVE10"
}

###

