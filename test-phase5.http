###############################################################
### VERIFY COMMISSION CALCULATIONS
###############################################################

### 7. Get Order by ID
# Check response for:
# - adminCommission field
# - sellerAmount field
# - Verify: sellerAmount = totalPrice - adminCommission
GET {{baseUrl}}/orders/REPLACE_WITH_ORDER_ID
Authorization: Bearer {{userToken}}

###

### 8. Get All Orders (Admin)
# Verify all orders have commission fields
GET {{baseUrl}}/orders
Authorization: Bearer {{adminToken}}

###

### 9. Get User Orders
# Check commission details in user's orders
GET {{baseUrl}}/orders/my-orders
Authorization: Bearer {{userToken}}

###

### 10. Get Seller Orders
# Verify seller can see their amount after commission
GET {{baseUrl}}/orders/seller-orders
Authorization: Bearer {{sellerToken}}

###

###############################################################
### COMMISSION CALCULATION EXAMPLES
###############################################################

# Example 1: ₹1000 Order
# Total Price: ₹1000
# Admin Commission: ₹1000 × 10/100 = ₹100
# Seller Amount: ₹1000 - ₹100 = ₹900

# Example 2: ₹2500 Order
# Total Price: ₹2500
# Admin Commission: ₹2500 × 10/100 = ₹250
# Seller Amount: ₹2500 - ₹250 = ₹2250

# Example 3: ₹500 Order
# Total Price: ₹500
# Admin Commission: ₹500 × 10/100 = ₹50
# Seller Amount: ₹500 - ₹50 = ₹450

