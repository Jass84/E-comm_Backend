### PHASE 5 - ADMIN COMMISSION SYSTEM TESTS
### Test admin commission (10%) and seller amount calculation

### Variables
@baseUrl = http://localhost:5000/api
@adminToken = YOUR_ADMIN_TOKEN_HERE
@userToken = YOUR_USER_TOKEN_HERE
@sellerToken = YOUR_SELLER_TOKEN_HERE

###############################################################
### SETUP - Login to get tokens
###############################################################

### 1. Admin Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ecommerce.com",
  "password": "admin123"
}

###

### 2. User Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "buyer123"
}

###

### 3. Seller Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "seller@example.com",
  "password": "seller123"
}

###

###############################################################
### CREATE ORDER - Test Commission Calculation
###############################################################

### 4. Create Order (₹1000 total)
# Expected:
# - Total Price: ₹1000
# - Admin Commission (10%): ₹100
# - Seller Amount: ₹900
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [
    {
      "product": "REPLACE_WITH_PRODUCT_ID",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "fullName": "Test Buyer",
    "phone": "9876543210",
    "addressLine1": "123 Test Street",
    "city": "Mumbai",
    "state": "Maharashtra",
    "pincode": "400001",
    "country": "India"
  },
  "paymentMethod": "COD",
  "itemsPrice": 900,
  "shippingPrice": 50,
  "taxPrice": 50,
  "totalPrice": 1000
}

###

