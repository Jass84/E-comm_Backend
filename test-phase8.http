GET {{baseUrl}}/admin/analytics/top-sellers?limit=5
Authorization: Bearer {{adminToken}}

### ============================================================
### DASHBOARD WORKFLOW TEST
### ============================================================

### WORKFLOW: Complete Admin Dashboard Flow

### Step 1: Login as Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "admin123"
}

### Step 2: View Dashboard
GET {{baseUrl}}/admin/dashboard
Authorization: Bearer {{adminToken}}

###
# Dashboard shows:
# - 1500 total users
# - 250 sellers (10 pending approval)
# - 5000 products
# - 12000 orders (150 pending)
# - ₹5M total revenue (₹500K commission)
# - 25 pending withdrawals
# - Last 7 days chart

### Step 3: Approve Pending Sellers
# View pending sellers
GET {{baseUrl}}/admin/sellers/pending
Authorization: Bearer {{adminToken}}

# Approve a seller
PUT {{baseUrl}}/admin/sellers/{{sellerId}}/approve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "approved": true
}

### Step 4: Manage Orders
# View all pending orders
GET {{baseUrl}}/admin/orders?status=pending
Authorization: Bearer {{adminToken}}

# Process an order
PUT {{baseUrl}}/admin/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "processing"
}

# Ship the order
PUT {{baseUrl}}/admin/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "shipped"
}

# Mark as delivered (credits seller earnings)
PUT {{baseUrl}}/admin/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "delivered"
}

### Step 5: Handle Withdrawal Requests
# View pending withdrawals
GET {{baseUrl}}/admin/withdrawals?status=pending
Authorization: Bearer {{adminToken}}

# Approve withdrawal
PUT {{baseUrl}}/admin/withdrawals/{{withdrawalId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "approved"
}

# Complete withdrawal
PUT {{baseUrl}}/admin/withdrawals/{{withdrawalId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "completed",
  "transactionId": "TXN123456"
}

### Step 6: Manage Products
# View out of stock products
GET {{baseUrl}}/admin/products?stock=out
Authorization: Bearer {{adminToken}}

# Update product stock
PUT {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stock": 50
}

# Deactivate problematic product
PUT {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### Step 7: Monitor Users
# View all users
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

# Block suspicious user
PUT {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### Step 8: View Analytics
# Revenue trends
GET {{baseUrl}}/admin/analytics/revenue?period=month
Authorization: Bearer {{adminToken}}

# Top products
GET {{baseUrl}}/admin/analytics/top-products?limit=10
Authorization: Bearer {{adminToken}}

# Top sellers
GET {{baseUrl}}/admin/analytics/top-sellers?limit=10
Authorization: Bearer {{adminToken}}

### ============================================================
### ERROR CASES
### ============================================================

### 60. Access Dashboard Without Admin Role (Should Fail)
GET {{baseUrl}}/admin/dashboard
Authorization: Bearer <NON_ADMIN_TOKEN>

### 61. Delete Admin User (Should Fail)
DELETE {{baseUrl}}/admin/users/<ADMIN_USER_ID>
Authorization: Bearer {{adminToken}}

### 62. Invalid Order Status (Should Fail)
PUT {{baseUrl}}/admin/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "invalid_status"
}

### 63. Update Non-Existent Product (Should Fail)
PUT {{baseUrl}}/admin/products/invalid_id
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "price": 100
}

### ============================================================
### BULK OPERATIONS TEST
### ============================================================

